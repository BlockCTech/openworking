{
  "name": "openworking",
  "version": "2.0.3",
  "private": true,
  "description": "OpenWorking — a local-first desktop shell for OpenCode with a self-configured OpenAI-compatible API gateway.",
  "license": "MIT",
  "author": "OpenWorking contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlockCTech/openworking.git"
  },
  "keywords": [
    "electron",
    "opencode",
    "ai",
    "desktop",
    "local-first",
    "coding-assistant"
  ],
  "main": "src/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.js",
    "build:document-tools": "node scripts/build-document-tools.js",
    "build:renderer": "node scripts/build-renderer.js",
    "predev": "npm run check:node && npm run build:document-tools && npm run build:renderer",
    "dev": "electron .",
    "prestart": "npm run check:node && npm run build:document-tools && npm run build:renderer",
    "start": "electron .",
    "pretest": "npm run check:node && npm run build:document-tools && npm run build:renderer",
    "test": "node --test-concurrency=2 --test test/*.test.js",
    "presmoke:electron": "npm run build:document-tools && npm run build:renderer",
    "smoke:electron": "node scripts/electron-smoke.js",
    "prepack:mac": "BUILD_MINIFY=1 npm run build:document-tools && BUILD_MINIFY=1 npm run build:renderer",
    "pack:mac": "electron-builder --mac dir -c.mac.forceCodeSigning=false -c.mac.notarize=false",
    "prepack:win": "npm run build:document-tools && npm run build:renderer && node scripts/build-windows-icon.js",
    "pack:win": "electron-builder --win dir",
    "predist:mac": "BUILD_MINIFY=1 npm run build:document-tools && BUILD_MINIFY=1 npm run build:renderer",
    "dist:mac": "electron-builder --mac dmg",
    "predist:mac:unsigned": "BUILD_MINIFY=1 npm run build:document-tools && BUILD_MINIFY=1 npm run build:renderer",
    "dist:mac:unsigned": "electron-builder --mac dmg -c.mac.forceCodeSigning=false -c.mac.notarize=false",
    "predist:win:unsigned": "npm run build:document-tools && npm run build:renderer && node scripts/build-windows-icon.js",
    "dist:win:unsigned": "electron-builder --win nsis",
    "predist:win": "npm run build:document-tools && npm run build:renderer && node scripts/build-windows-icon.js",
    "dist:win": "node scripts/windows-release.js --no-bump",
    "presmoke:packaged": "npm run build:document-tools && npm run build:renderer",
    "smoke:packaged": "node scripts/packaged-smoke.js",
    "pretest:e2e": "npm run build:document-tools",
    "presmoke:packaged:win": "npm run build:document-tools && npm run build:renderer && node scripts/build-windows-icon.js",
    "smoke:packaged:win": "node scripts/packaged-smoke.js --platform=win32",
    "smoke:installer:win": "node scripts/windows-installer-smoke.js",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run build:document-tools",
    "test:e2e:headed": "playwright test --headed",
    "pretest:e2e:ui": "npm run build:document-tools",
    "test:e2e:ui": "playwright test --ui",
    "preverify": "npm run build:document-tools && npm run build:renderer",
    "verify": "node --test-concurrency=2 --test test/*.test.js",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "release:mac": "node scripts/release.js",
    "prerelease:win": "npm run build:document-tools && npm run build:renderer && node scripts/build-windows-icon.js",
    "release:win": "node scripts/windows-release.js"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "^2.14.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.50.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.5",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "svelte": "^5.56.5",
    "tar": "^7.5.19",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "@opencode-ai/cli": "0.0.0-next-17292",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "marked": "18.0.3",
    "mermaid": "^11.15.0",
    "mime-types": "2.1.35",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "ai.openworking.desktop",
    "productName": "OpenWorking",
    "asar": true,
    "beforePack": "scripts/before-pack.js",
    "electronLanguages": [
      "en"
    ],
    "asarUnpack": [
      "node_modules/@opencode-ai/cli-*/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.{map,d.ts,ts}",
      "!**/{test,tests,__tests__,example,examples,.github}/**",
      "!node_modules/@highlightjs/cdn-assets/**/*",
      "node_modules/@highlightjs/cdn-assets/highlight.min.js",
      "node_modules/@highlightjs/cdn-assets/styles/github-dark.min.css",
      "node_modules/@highlightjs/cdn-assets/styles/github.min.css",
      "!node_modules/mermaid/**/*",
      "node_modules/mermaid/dist/mermaid.min.js",
      "node_modules/mermaid/package.json",
      "!node_modules/@mermaid-js/**/*",
      "!node_modules/cytoscape*/**/*",
      "!node_modules/cose-base/**/*",
      "!node_modules/layout-base/**/*",
      "!node_modules/dagre-d3-es/**/*",
      "!node_modules/d3*/**/*",
      "!node_modules/internmap/**/*",
      "!node_modules/delaunator/**/*",
      "!node_modules/robust-predicates/**/*",
      "!node_modules/es-toolkit/**/*",
      "!node_modules/lodash-es/**/*",
      "!node_modules/katex/**/*",
      "!node_modules/dompurify/**/*",
      "!node_modules/roughjs/**/*",
      "!node_modules/hachure-fill/**/*",
      "!node_modules/points-on-curve/**/*",
      "!node_modules/points-on-path/**/*",
      "!node_modules/path-data-parser/**/*",
      "!node_modules/@iconify/**/*",
      "!node_modules/@braintree/**/*",
      "!node_modules/@chevrotain/**/*",
      "!node_modules/@upsetjs/**/*",
      "!node_modules/khroma/**/*",
      "!node_modules/stylis/**/*",
      "!node_modules/ts-dedent/**/*",
      "!node_modules/dayjs/**/*",
      "!node_modules/rw/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/opencode",
        "to": "opencode"
      },
      {
        "from": "resources/browser-host",
        "to": "browser-host"
      },
      {
        "from": "resources/browser-mcp",
        "to": "browser-mcp"
      },
      {
        "from": "resources/browser-extension",
        "to": "browser-extension"
      }
    ],
    "dmg": {
      "format": "ULFO"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "src/assets/thumbnail_icon.png",
      "notarize": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "OpenWorking needs access to open project folders you keep on your Desktop.",
        "NSDocumentsFolderUsageDescription": "OpenWorking needs access to open project folders you keep in Documents.",
        "NSDownloadsFolderUsageDescription": "OpenWorking needs access to open project folders you keep in Downloads."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "src/assets/windows.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
